# Copy to .env.local. Retr0 Academy runs on NEAR mainnet by default (lib/near.ts).
# Network: "mainnet" (default) or "testnet".
NEXT_PUBLIC_NEAR_NETWORK=mainnet
NEXT_PUBLIC_DIPLOMA_CONTRACT=diploma.hlpok1lad.tg
# Optional custom RPC for the selected network (leave empty to use the built-in mainnet RPC list).
NEXT_PUBLIC_NEAR_RPC=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CODE_E_URL=https://code-e-near.vercel.app

# --- server secrets (never commit real values) ---
# Root for session / pass-token / cookie HMAC keys. 32 random bytes, hex: `openssl rand -hex 32`.
# Required in production (the app refuses to issue sessions without it). Locally a random per-process value is used.
R0_SESSION_SECRET=
# ed25519 attestor seed (32 bytes hex) whose public key is set on the diploma contract with set_attestor.
# Mainnet uses NEAR_ATTESTOR_SEED_MAINNET; testnet uses NEAR_ATTESTOR_SEED. Without it nothing can be attested.
NEAR_ATTESTOR_SEED_MAINNET=
NEAR_ATTESTOR_SEED=
# AES-256-GCM key (hex) for exam/bank.enc.json. Without it the public practice bank is used (no certificates).
EXAM_BANK_KEY=
# Vercel Blob (ship records and single-use markers). Required in production.
BLOB_READ_WRITE_TOKEN=
# Retr0 Tutor (NEAR AI Cloud). TUTOR_DAILY_CAP must be a positive integer (default 5000).
NEAR_AI_API_KEY=
TUTOR_DAILY_CAP=5000
